              "cordura": -1
            }
          }
        }
      ]
    },
    "cap07_r02": {
      "texto": "[ESQUELETO DE RAMA] Los fantasmas se callan. El silencio es peor que sus voces. Coraline se arrepiente y les pide que le cuenten.",
      "diseno": "exploracion_derecha",
      "fondo": "ninos_fantasma",
      "espejo": true,
      "titulo_escena": "Un silencio peor",
      "pregunta": "¿QUÉ HACES?",
      "canonico": false,
