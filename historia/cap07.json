    },
    "cap07_n02": {
      "texto": "Son tres niños fantasma, pálidos como nubes. Llevan muchísimo tiempo ahí. La otra madre los atrapó, a cada uno en su época: les dio todo lo que pedían y luego les quitó el alma y los dejó olvidados detrás del espejo.",
      "diseno": "exploracion_derecha",
      "fondo": "ninos_fantasma",
      "espejo": true,
      "titulo_escena": "Los niños fantasma",
      "pregunta": "¿QUÉ LES DICES?",
      "canonico": true,
      "opciones": [
        {
          "texto": "Pedirles que le cuenten su historia",
          "destino": "cap07_n03",
          "canonica": true
        },
        {
          "texto": "Decirles que la dejen en paz",
          "destino": "cap07_r02",
          "canonica": false,
          "efectos": {
